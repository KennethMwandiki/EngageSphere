# Example environment variables (do NOT commit secrets)
# Copy this file to .env and fill in real secrets for local development only.

JWT_SECRET=your-base64-or-random-secret-here
# Add other service secrets below as needed (VERCEL_TOKEN, ANDROID_KEYSTORE_BASE64, etc.)

# AI provider defaults and keys
# Set the global default provider used by the backend when a request
# does not explicitly specify one. Valid examples: `azure`, `vertex`, `gpt5mini`.
# For preview Raptor/GPT-5 mini behavior, set to `gpt5mini`.
DEFAULT_AI_PROVIDER=gpt5mini

# Provider keys (fill the ones you plan to use):
# AZURE_OPENAI_KEY=your_azure_openai_key
# VERTEX_AI_KEY=your_vertex_ai_key
# GPT5_MINI_KEY=your_gpt5_mini_key

# Agora integration (replace with your Agora app configuration)
# AGORA_APP_ID=your_agora_app_id
# AGORA_REST_API_KEY=rest-api-host-or-key
# AGORA_CHAT_APPKEY=your_agora_chat_appkey
# AGORA_ORGNAME=your_agora_orgname
# AGORA_APPNAME=your_agora_appname
